// JSuzuki Control - esquema de datos
// Toda cantidad monetaria se guarda como Decimal(14,2): precision exacta, sin floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Conexion directa (sin pooler en modo transaccion) para las migraciones.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

/// Clasificacion de un gasto: fijo mensual, variable o extraordinario (una vez).
enum ExpenseKind {
  FIXED
  VARIABLE
  EXTRAORDINARY
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum AccountKind {
  CASH
  BANK
  WALLET
  INVESTMENT
  OTHER
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

enum DebtStatus {
  ACTIVE
  PAID
  CANCELLED
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  CANCELLED
}

enum AssetKind {
  BANK_ACCOUNT
  CASH
  FIXED_INCOME
  STOCKS
  CRYPTO
  REAL_ESTATE
  VEHICLE
  OTHER
}

/// De donde salio el movimiento. Permite distinguir lo manual de lo importado.
enum MovementSource {
  MANUAL
  RECURRING
  IMPORT
  MERCADOPAGO
}

/// Estado de conciliacion de un movimiento importado.
enum ReconcileStatus {
  NONE
  PENDING_REVIEW
  CONFIRMED
  DISCARDED
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  ERROR
}

enum NotificationKind {
  DUE_DATE
  BUDGET_EXCEEDED
  UNUSUAL_EXPENSE
  GOAL_PROGRESS
  MONTH_CLOSE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  IMPORT
  EXPORT
  SYNC
  BACKUP
}

enum AllocationKind {
  ESSENTIAL
  PERSONAL
  SAVINGS
  INVESTMENT
  DEBT
}

// ---------------------------------------------------------------------------
// Usuario, sesion y configuracion
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  currency     String   @default("BRL")
  locale       String   @default("es")
  dateFormat   String   @default("dd/MM/yyyy")
  theme        String   @default("dark")
  timezone     String   @default("America/Sao_Paulo")
  /// Dia del mes en que arranca el ciclo financiero (1 = mes calendario).
  monthStartDay Int     @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions             Session[]
  accounts             FinancialAccount[]
  categories           Category[]
  transactions         Transaction[]
  recurringRules       RecurringRule[]
  budgets              Budget[]
  allocationRules      AllocationRule[]
  debts                Debt[]
  goals                SavingsGoal[]
  assets               Asset[]
  notifications        Notification[]
  notificationSettings NotificationSetting[]
  auditLogs            AuditLog[]
  importBatches        ImportBatch[]
  mpConnection         MercadoPagoConnection?
  monthClosings        MonthClosing[]
  expenseTemplates     ExpenseTemplate[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Cuentas y categorias
// ---------------------------------------------------------------------------

/// Cuenta donde vive el dinero (efectivo, banco, Mercado Pago...).
/// Las transferencias entre cuentas propias NO son ingreso ni gasto.
model FinancialAccount {
  id             String      @id @default(cuid())
  userId         String
  name           String
  kind           AccountKind @default(BANK)
  currency       String      @default("BRL")
  /// Saldo con el que arranca la cuenta antes del primer movimiento registrado.
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)
  isDefault      Boolean     @default(false)
  archivedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("accountTransactions")
  transfersIn  Transaction[] @relation("toAccountTransactions")

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  kind      CategoryKind
  /// Nombre del icono (se resuelve en el cliente).
  icon      String       @default("tag")
  /// Color hex para graficos.
  color     String       @default("#64748b")
  isSystem  Boolean      @default(false)
  /// Limite mensual por defecto de esta categoria (opcional).
  monthlyLimit Decimal?  @db.Decimal(14, 2)
  sortOrder Int          @default(0)
  archivedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  recurringRules   RecurringRule[]
  budgetCategories BudgetCategory[]
  importRules      ImportRule[]
  templateItems    ExpenseTemplateItem[]

  @@unique([userId, name, kind])
  @@index([userId, kind])
}

// ---------------------------------------------------------------------------
// Movimientos
// ---------------------------------------------------------------------------

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2)
  date        DateTime        @db.Date
  description String
  notes       String?
  currency    String          @default("BRL")

  categoryId String?
  accountId  String?
  /// Cuenta destino cuando type = TRANSFER.
  toAccountId String?

  /// Solo para gastos: fijo / variable / extraordinario.
  expenseKind ExpenseKind?

  source MovementSource @default(MANUAL)

  /// Identificador externo unico (Mercado Pago, fila de un import).
  /// Garantiza que un mismo movimiento no se cuente dos veces.
  externalId String?
  /// Hash del contenido de la fila importada, para detectar duplicados.
  importHash String?

  reconcileStatus ReconcileStatus @default(NONE)
  /// Transaccion manual con la que se concilio este movimiento importado.
  reconciledWithId String?

  recurringRuleId String?
  debtPaymentId   String?  @unique
  goalContributionId String? @unique
  importBatchId   String?

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account        FinancialAccount?  @relation("accountTransactions", fields: [accountId], references: [id], onDelete: SetNull)
  toAccount      FinancialAccount?  @relation("toAccountTransactions", fields: [toAccountId], references: [id], onDelete: SetNull)
  recurringRule  RecurringRule?     @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  debtPayment    DebtPayment?       @relation(fields: [debtPaymentId], references: [id], onDelete: SetNull)
  goalContribution GoalContribution? @relation(fields: [goalContributionId], references: [id], onDelete: SetNull)
  importBatch    ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  reconciledWith Transaction?       @relation("reconciliation", fields: [reconciledWithId], references: [id], onDelete: SetNull)
  reconciledBy   Transaction[]      @relation("reconciliation")

  @@unique([userId, externalId])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([userId, categoryId])
  @@index([userId, deletedAt])
  @@index([userId, importHash])
}

/// Regla que genera movimientos automaticamente (salario, alquiler, suscripciones).
model RecurringRule {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2)
  description String
  notes       String?
  categoryId  String?
  accountId   String?
  expenseKind ExpenseKind?    @default(FIXED)

  frequency Frequency @default(MONTHLY)
  /// Dia del mes (1-31) para frecuencias mensuales o mayores.
  dayOfMonth Int?
  /// Dia de la semana (0 domingo - 6 sabado) para frecuencias semanales.
  dayOfWeek Int?

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  isActive  Boolean   @default(true)
  /// Ultima fecha para la que ya se genero el movimiento (evita duplicar).
  lastRunDate DateTime? @db.Date

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, isActive])
}

/// Plantilla de gastos mensuales reutilizable.
model ExpenseTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ExpenseTemplateItem[]

  @@unique([userId, name])
}

model ExpenseTemplateItem {
  id          String      @id @default(cuid())
  templateId  String
  description String
  amount      Decimal     @db.Decimal(14, 2)
  categoryId  String?
  expenseKind ExpenseKind @default(FIXED)
  dayOfMonth  Int?

  template ExpenseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([templateId])
}

// ---------------------------------------------------------------------------
// Planificacion
// ---------------------------------------------------------------------------

model Budget {
  id     String @id @default(cuid())
  userId String
  year   Int
  month  Int

  plannedIncome  Decimal @default(0) @db.Decimal(14, 2)
  plannedExpense Decimal @default(0) @db.Decimal(14, 2)
  savingsTarget  Decimal @default(0) @db.Decimal(14, 2)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@unique([userId, year, month])
  @@index([userId, year])
}

model BudgetCategory {
  id         String  @id @default(cuid())
  budgetId   String
  categoryId String
  limit      Decimal @db.Decimal(14, 2)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
}

/// Distribucion porcentual del salario. La suma la valida la aplicacion.
model AllocationRule {
  id      String         @id @default(cuid())
  userId  String
  kind    AllocationKind
  label   String
  percent Decimal        @db.Decimal(5, 2)
  sortOrder Int          @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId])
}

/// Cierre financiero de un mes: congela los totales para que el historico no cambie.
model MonthClosing {
  id     String @id @default(cuid())
  userId String
  year   Int
  month  Int

  totalIncome    Decimal @db.Decimal(14, 2)
  totalExpense   Decimal @db.Decimal(14, 2)
  totalSavings   Decimal @db.Decimal(14, 2)
  totalDebtPaid  Decimal @db.Decimal(14, 2)
  closingBalance Decimal @db.Decimal(14, 2)
  netWorth       Decimal @db.Decimal(14, 2)
  notes          String?
  closedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
}

// ---------------------------------------------------------------------------
// Deudas
// ---------------------------------------------------------------------------

model Debt {
  id       String @id @default(cuid())
  userId   String
  name     String
  creditor String

  originalAmount Decimal  @db.Decimal(14, 2)
  /// Tasa de interes anual en porcentaje (0 si no tiene).
  interestRate   Decimal  @default(0) @db.Decimal(6, 3)
  installments   Int      @default(1)
  installmentAmount Decimal? @db.Decimal(14, 2)
  dueDate        DateTime @db.Date
  /// Dia del mes en que vence cada cuota.
  dueDayOfMonth  Int?
  status         DebtStatus @default(ACTIVE)
  notes          String?

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([userId, status])
}

model DebtPayment {
  id     String   @id @default(cuid())
  debtId String
  amount Decimal  @db.Decimal(14, 2)
  date   DateTime @db.Date
  notes  String?
  createdAt DateTime @default(now())

  debt        Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction Transaction[]

  @@index([debtId])
}

// ---------------------------------------------------------------------------
// Ahorros y objetivos
// ---------------------------------------------------------------------------

model SavingsGoal {
  id           String     @id @default(cuid())
  userId       String
  name         String
  targetAmount Decimal    @db.Decimal(14, 2)
  deadline     DateTime?  @db.Date
  status       GoalStatus @default(ACTIVE)
  color        String     @default("#10b981")
  icon         String     @default("target")
  notes        String?

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@unique([userId, name])
  @@index([userId, status])
}

model GoalContribution {
  id     String   @id @default(cuid())
  goalId String
  amount Decimal  @db.Decimal(14, 2)
  date   DateTime @db.Date
  notes  String?
  createdAt DateTime @default(now())

  goal        SavingsGoal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction Transaction[]

  @@index([goalId])
}

// ---------------------------------------------------------------------------
// Patrimonio
// ---------------------------------------------------------------------------

model Asset {
  id       String    @id @default(cuid())
  userId   String
  name     String
  kind     AssetKind
  /// Valor actual declarado por el usuario.
  value    Decimal   @db.Decimal(14, 2)
  /// Cantidad (acciones, cripto). Opcional.
  quantity Decimal?  @db.Decimal(18, 8)
  /// true = pasivo (resta del patrimonio).
  isLiability Boolean @default(false)
  notes    String?
  acquiredAt DateTime? @db.Date

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  valuations  AssetValuation[]

  @@index([userId, kind])
}

/// Historial de valuaciones, para graficar la evolucion patrimonial.
model AssetValuation {
  id      String   @id @default(cuid())
  assetId String
  value   Decimal  @db.Decimal(14, 2)
  date    DateTime @db.Date
  /// Fuente del valor: MANUAL o el nombre de la fuente externa.
  source  String   @default("MANUAL")
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, date])
  @@index([assetId])
}

// ---------------------------------------------------------------------------
// Importacion
// ---------------------------------------------------------------------------

model ImportBatch {
  id       String   @id @default(cuid())
  userId   String
  fileName String
  format   String
  rowsRead Int      @default(0)
  imported Int      @default(0)
  skipped  Int      @default(0)
  failed   Int      @default(0)
  /// Detalle fila por fila de lo que paso.
  report   Json?
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

/// Regla aprendida: "si la descripcion contiene X, la categoria es Y".
model ImportRule {
  id         String       @id @default(cuid())
  userId     String
  pattern    String
  kind       CategoryKind
  categoryId String
  /// Cuantas veces se confirmo esta regla. Ordena la prioridad.
  hits       Int          @default(1)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern, kind])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Mercado Pago (solo lectura)
// ---------------------------------------------------------------------------

model MercadoPagoConnection {
  id     String @id @default(cuid())
  userId String @unique

  /// Tokens cifrados con AES-256-GCM. Nunca se guardan en claro.
  accessTokenEnc  String
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  mpUserId        String?
  publicKey       String?
  scope           String?
  /// Cuenta local donde se registran los movimientos importados.
  accountId       String?

  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs SyncRun[]
}

model SyncRun {
  id           String     @id @default(cuid())
  connectionId String
  status       SyncStatus @default(PENDING)
  /// Identificador del reporte pedido a Mercado Pago.
  reportId     String?
  reportFile   String?
  rangeFrom    DateTime?
  rangeTo      DateTime?
  imported     Int        @default(0)
  skipped      Int        @default(0)
  error        String?
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?

  connection MercadoPagoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
}

// ---------------------------------------------------------------------------
// Notificaciones y auditoria
// ---------------------------------------------------------------------------

model NotificationSetting {
  id       String           @id @default(cuid())
  userId   String
  kind     NotificationKind
  enabled  Boolean          @default(true)
  /// Dias de anticipacion para avisos de vencimiento.
  daysBefore Int            @default(3)
  /// Umbral en porcentaje para alertas de presupuesto o gasto inusual.
  threshold  Int            @default(90)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  kind    NotificationKind
  title   String
  body    String
  /// Clave estable para no repetir el mismo aviso.
  dedupeKey String
  severity String          @default("info")
  link    String?
  readAt  DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

model AuditLog {
  id       String      @id @default(cuid())
  userId   String
  action   AuditAction
  entity   String
  entityId String?
  summary  String
  payload  Json?
  ipAddress String?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, entity])
}
