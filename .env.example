# ---------------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------------
# DATABASE_URL la usa la aplicacion; DIRECT_URL, las migraciones.
# En local pueden ser la misma cadena.
# En Vercel + Supabase: DATABASE_URL = pooler en modo "transaction" (puerto 6543)
# con ?pgbouncer=true&connection_limit=1, y DIRECT_URL = conexion en modo
# "session" o directa (puerto 5432). Con el modo session en DATABASE_URL las
# funciones serverless agotan el pool (EMAXCONNSESSION).
DATABASE_URL="postgresql://usuario:password@host:5432/finance_control?schema=public"
DIRECT_URL="postgresql://usuario:password@host:5432/finance_control?schema=public"

# ---------------------------------------------------------------------------
# Seguridad (OBLIGATORIO en produccion)
# Genera cada valor con: openssl rand -base64 48
# ---------------------------------------------------------------------------
# Firma de las cookies de sesion
AUTH_SECRET=""
# Clave de cifrado para los tokens de Mercado Pago (AES-256-GCM)
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Aplicacion
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
# Deja vacio para permitir registro libre; si lo completas, solo ese correo puede registrarse
ALLOWED_SIGNUP_EMAIL=""

# ---------------------------------------------------------------------------
# Mercado Pago (opcional - integracion de solo lectura)
# Crea una aplicacion en https://www.mercadopago.com.br/developers/panel/app
# Redirect URL de la aplicacion: {APP_URL}/api/mercadopago/callback
# ---------------------------------------------------------------------------
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
# URL de vuelta del OAuth. Tiene que ser fija y estar cargada igual en la
# aplicacion de Mercado Pago. Si se deja vacia se usa {APP_URL}/api/mercadopago/callback
MERCADOPAGO_REDIRECT_URI=""

# ---------------------------------------------------------------------------
# Tarea periodica (GET /api/cron, una vez por dia desde Vercel)
# Aplica las recurrencias, genera los avisos y sincroniza Mercado Pago.
# Sin este valor el endpoint no responde.
# ---------------------------------------------------------------------------
CRON_SECRET=""
