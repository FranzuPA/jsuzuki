{
  "name": "jsuzuki-control",
  "version": "1.0.0",
  "private": true,
  "description": "JSuzuki Control - sistema integral de finanzas personales",
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "decimal.js": "10.6.0",
    "exceljs": "^4.4.0",
    "jose": "6.2.17",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "pdfkit": "^0.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "^19.3.1",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.19.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
